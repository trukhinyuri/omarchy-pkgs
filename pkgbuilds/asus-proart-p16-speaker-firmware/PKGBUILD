# Maintainer: Yuri Trukhin <yuri@trukhin.com>
#
# Cirrus Logic CS35L56 speaker amplifier firmware and tuning for the ASUS ProArt
# P16 H7607BA (NVIDIA N1x), SoundWire subsystem ID 1043:1484. Without it the
# amplifiers run their ROM defaults: quiet, a mono mix, and without ASUS's
# speaker protection, calibration or correction. linux-firmware has no tuning
# for this model.
#
# ASUS ships the tuning in the same Windows audio driver as the ProArt P14's:
# the H7407BA package carries the 1484 tunings beside the 33A1 ones, and they
# are byte-identical to the files Windows runs on an H7607BA. This recipe
# unpacks that driver without running it.
#
# The files are Cirrus Logic's, installed unmodified under the names the cs35l56
# driver requests, with the Cirrus licence linux-firmware distributes Cirrus's
# amplifier firmware under. The DSP firmware is the same 3.13.4 build the P14
# package carries; the tunings are built against it.
#
# Drop this package once Cirrus adds 10431484 to linux-firmware, where these
# files would conflict with linux-firmware-cirrus.

pkgname=asus-proart-p16-speaker-firmware
pkgver=1.0.678.52824
pkgrel=1
pkgdesc='Cirrus CS35L56 speaker amplifier firmware and tuning for the ASUS ProArt P16 (H7607BA)'
arch=('aarch64')
url='https://www.asus.com/laptops/for-creators/proart/proart-p16-h7607/helpdesk_download?model2Name=H7607BA'
license=('LicenseRef-Cirrus')
makedepends=('7zip')
options=('!strip' '!debug')
_exe=Audio_Driver_ARM_Cirrus_Z_V${pkgver}Sub3_49783.exe
source=("$_exe::https://dlcdnets.asus.com/pub/ASUS/nb/Image/Driver/Audio/49783/$_exe?model=H7407BA"
        'LICENSE.cirrus')
sha256sums=('01ffa79558813cf9e943d63b4a39289471915ab865c32a1138ffe8382175355f'
            'ff6e5ab98d3e3c50d9e750580059bc23a0663a5613659828d0536db44c38f4e0')

prepare() {
  # The installer is an Inno Setup executable with the driver package appended
  # as a 7z archive. Cut the archive out and unpack it.
  local offset
  offset=$(LC_ALL=C grep -obUaP '7z\xBC\xAF\x27\x1C' "$_exe" | head -1 | cut -d: -f1)
  [[ -n $offset ]] || { echo "no 7z archive in $_exe" >&2; return 1; }
  tail -c +$((offset + 1)) "$_exe" > driver.7z
  rm -rf driver
  7z x -y -odriver driver.7z >/dev/null
}

package() {
  local fw=driver/XU_Ext/fw/35L56/3.13.4/dflt
  local tn=driver/XU_Ext/tn/35L56/1484/dflt
  local dest="$pkgdir/usr/lib/firmware/cirrus"
  local base=cs35l56-b0-dsp1-misc-10431484

  install -Dm644 "$fw/b0_dflt_35l56_3.13.4.wmfw" "$dest/$base-spkid0.wmfw"
  install -Dm644 "$tn/b0_dflt_1484_lw_l1u0.bin" "$dest/$base-spkid0-l1u0.bin"
  install -Dm644 "$tn/b0_dflt_1484_rw_l1u1.bin" "$dest/$base-spkid0-l1u1.bin"

  # The driver reads a speaker ID pin and names the files after it. Windows
  # applies this one tuning whatever the pin says, so do the same.
  local f
  for f in .wmfw -l1u0.bin -l1u1.bin; do
    ln -s "$base-spkid0$f" "$dest/$base-spkid1$f"
  done

  install -Dm644 LICENSE.cirrus "$pkgdir/usr/share/licenses/$pkgname/LICENSE.cirrus"
}
